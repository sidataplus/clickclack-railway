# Local test example. Real .env files are ignored by Git and Docker.
CC_BOOTSTRAP_EMAIL=admin@example.com
CC_BOOTSTRAP_NAME=Admin
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
CC_BOOTSTRAP_PASSWORD=REPLACE_ME
CLICKCLACK_DATA=/app/data
CLICKCLACK_PASSWORD_AUTH_ENABLED=true
CLICKCLACK_DEV_BOOTSTRAP=false
PORT=8080
# On Railway, the wrapper uses RAILWAY_PUBLIC_DOMAIN automatically.
# CLICKCLACK_PUBLIC_URL=https://chat.example.org
